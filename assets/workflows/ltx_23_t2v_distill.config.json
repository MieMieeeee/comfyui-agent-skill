{
  "workflow_id": "ltx_23_t2v_distill",
  "workflow_file": "ltx-23-t2v.json",
  "output_node_title": "Video Combine (Primary MP4)",
  "capability": "text_to_video",
  "description": "LTX-2.3 dev text-to-video",
  "output_kind": "video",
  "intent_categories": ["text_to_video", "video"],
  "input_modes": ["text"],
  "priority": 70,
  "keywords_any": ["video", "mp4", "视频", "短片", "镜头", "运镜", "动画"],
  "selection_guidance": {
    "best_for": [
      "text-to-video generation",
      "shot-based prompts with camera/motion"
    ],
    "avoid_for": [
      "image-to-video requests with a provided input image"
    ],
    "agent_hint": "Use this workflow when the user wants a video from text. Width/height are supported when provided together."
  },
  "resolution_presets": {
    "landscape_fast": {
      "width": 768,
      "height": 512,
      "label": "Fast (3:2)"
    },
    "landscape_hd": {
      "width": 1280,
      "height": 704,
      "label": "HD"
    },
    "landscape_fhd": {
      "width": 1920,
      "height": 1088,
      "label": "Full HD"
    }
  },
  "default_resolution": "landscape_fast",
  "node_mapping": {
    "prompt": {
      "node_title": "CLIP Text Encode (Positive Prompt)",
      "param": "text",
      "value_type": "string",
      "required": true
    },
    "negative_prompt": {
      "node_title": "CLIP Text Encode (Prompt)",
      "param": "text",
      "value_type": "string"
    },
    "width": {
      "node_title": "EmptyImage",
      "param": "width",
      "value_type": "integer",
      "default": 768
    },
    "height": {
      "node_title": "EmptyImage",
      "param": "height",
      "value_type": "integer",
      "default": 512
    }
  }
}
